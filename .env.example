# Web/API authentication
# Set this before exposing the dashboard outside localhost.
QUANT_SYSTEM_API_KEY=
APP_ENV=development

# OpenAI-compatible LLM settings
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.5

# Unified AI Runtime. Secret bodies remain in environment variables; provider
# records persist only references such as env://OPENAI_API_KEY.
AI_LLM_PROTOCOL=openai_compatible
AI_LLM_BASE_URL=
AI_LLM_MODEL=gpt-5.5
AI_LLM_SECRET_REF=env://OPENAI_API_KEY
AI_LLM_COMMAND=
AI_INLINE_EXECUTION=false
PI_AGENT_WORKER_ENABLED=false
PI_AGENT_WORKER_LEASE_TTL_SECONDS=30
PI_AGENT_WORKER_POLL_INTERVAL_SECONDS=2
PI_AGENT_WORKER_BATCH_SIZE=4

# Optional initial 6-character invite code. Defaults to LOCAL1 for local dev.
QUANT_DEFAULT_INVITE_CODE=LOCAL1

# Data source settings
DATA_SOURCE_MODE=new
MOOTDX_SERVERS=
IWENCAI_COOKIE=
SHADOW_SAMPLE_RATE=0.1

# Logging
LOG_LEVEL=INFO
